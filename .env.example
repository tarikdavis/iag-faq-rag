# Copy to .env (gitignored) and fill in.

# Contentful Delivery API (read-only). Create at
# https://app.contentful.com/spaces/<space>/api/keys
CONTENTFUL_SPACE_ID=
CONTENTFUL_DELIVERY_TOKEN=
CONTENTFUL_ENVIRONMENT=master

# Anthropic API key — used for generation.
# Console: https://console.anthropic.com/
ANTHROPIC_API_KEY=
